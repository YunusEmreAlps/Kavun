      </column>
      <column name="revtype" type="SMALLINT"/>
      <column name="revend" type="INT">
        <constraints foreignKeyName="fk_users_audit_log_revend"
            referencedTableName="revinfo" referencedColumnNames="rev"/>
      </column>
      <column name="username" type="VARCHAR(255)"/>
      <column name="email" type="VARCHAR(255)"/>
      <column name="password" type="VARCHAR(255)"/>
      <column name="first_name" type="VARCHAR(255)"/>
      <column name="middle_name" type="VARCHAR(255)"/>
      <column name="last_name" type="VARCHAR(255)"/>
      <column name="title" type="VARCHAR(255)"/>
      <column name="phone" type="VARCHAR(255)"/>
      <column name="address" type="${type.text}"/>
      <column name="profile_image" type="VARCHAR(255)"/>
      <column name="verification_token" type="VARCHAR(512)"/>
      <column name="otp_delivery_method" type="VARCHAR(255)"/>
      <column name="enabled" type="BOOLEAN"/>
      <column name="account_non_expired" type="BOOLEAN"/>
      <column name="account_non_locked" type="BOOLEAN"/>
      <column name="credentials_non_expired" type="BOOLEAN"/>
      <column name="failed_login_attempts" type="INT"/>
      <column name="last_successful_login" type="TIMESTAMP"/>
    </createTable>
  </changeSet>


      <column name="tenant_code" type="VARCHAR(50)"><constraints nullable="false"/></column>
      <column name="user_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_user_role_user"
            referencedTableName="users" referencedColumnNames="id"/>
      </column>
      <column name="role_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_user_role_role"
            referencedTableName="role" referencedColumnNames="id"/>
      </column>
      <column name="public_id" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_user_role_public_id"/>
      </column>
      <column name="version" type="INT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
      <column name="updated_at" type="TIMESTAMP"/>
      <column name="updated_by" type="BIGINT"/>
      <column name="deleted" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="deleted_at" type="TIMESTAMP"/>
      <column name="deleted_by" type="BIGINT"/>
      <column name="order_index" type="INT"/>
    </createTable>
    <addUniqueConstraint tableName="user_role" columnNames="user_id, role_id"
        constraintName="uk_user_role"/>
    <createIndex tableName="user_role" indexName="idx_user_role_user">
      <column name="user_id"/>
    </createIndex>
    <createIndex tableName="user_role" indexName="idx_user_role_role">
      <column name="role_id"/>
    </createIndex>
    <createIndex tableName="user_role" indexName="idx_user_role_deleted">
      <column name="deleted"/>
    </createIndex>
  </changeSet>

  <changeSet id="baseline-user-history" author="kavun">
    <preConditions onFail="MARK_RAN">

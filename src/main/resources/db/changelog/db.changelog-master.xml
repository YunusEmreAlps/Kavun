<?xml version="1.0" encoding="UTF-8"?>
<!--
  The database schema, applied by Liquibase on startup. Hibernate only validates it
  (ddl-auto=validate), so every entity change needs a changeset here: add a new file under
  changes/ and include it below. Never edit a changeset that has been applied. See
  docs/DATABASE_MIGRATIONS.md.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Use ${type.text} for unbounded text columns: H2 (integration tests) turns TEXT into a CLOB,
    which Hibernate's validation rejects for String fields.
  -->
  <property name="type.text" value="TEXT" dbms="postgresql"/>
  <property name="type.text" value="VARCHAR" dbms="h2"/>

  <include file="changes/001-baseline.xml" relativeToChangelogFile="true"/>
  <include file="changes/002-user-devices-last-seen.xml" relativeToChangelogFile="true"/>
  <include file="changes/003-search-fold.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  The schema as it stood when Liquibase took over from Hibernate's ddl-auto, one changeset per
  table.

  Databases created earlier by ddl-auto already have these tables: a changeset whose table exists
  is marked as ran without being executed, and Hibernate's validation then checks that the
  existing tables match the entities.

  Enum columns are plain VARCHAR without CHECK constraints, so adding an enum constant needs no
  migration.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="baseline-tenants" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="tenants"/></not>
    </preConditions>
    <createTable tableName="tenants">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_tenants" nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_tenants_code"/>
      </column>
      <column name="name" type="VARCHAR(200)"><constraints nullable="false"/></column>
      <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="public_id" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_tenants_public_id"/>
      </column>
      <column name="version" type="INT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
      <column name="updated_at" type="TIMESTAMP"/>
      <column name="updated_by" type="BIGINT"/>
      <column name="deleted" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="deleted_at" type="TIMESTAMP"/>
      <column name="deleted_by" type="BIGINT"/>
      <column name="order_index" type="INT"/>
    </createTable>
  </changeSet>

  <changeSet id="baseline-users" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="users"/></not>
    </preConditions>
    <createTable tableName="users">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_users" nullable="false"/>
      </column>
      <column name="tenant_code" type="VARCHAR(50)"><constraints nullable="false"/></column>
      <column name="username" type="VARCHAR(50)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_username"/>
      </column>
      <column name="email" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
      </column>
      <column name="password" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="first_name" type="VARCHAR(255)"/>
      <column name="middle_name" type="VARCHAR(255)"/>
      <column name="last_name" type="VARCHAR(255)"/>
      <column name="title" type="VARCHAR(255)"/>
      <column name="phone" type="VARCHAR(255)"/>
      <column name="address" type="${type.text}"/>
      <column name="profile_image" type="VARCHAR(255)"/>
      <column name="verification_token" type="VARCHAR(512)"/>
      <column name="otp_delivery_method" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="account_non_expired" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="account_non_locked" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="credentials_non_expired" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="failed_login_attempts" type="INT"><constraints nullable="false"/></column>
      <column name="last_successful_login" type="TIMESTAMP"/>
      <column name="public_id" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_public_id"/>
      </column>
      <column name="version" type="INT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
      <column name="updated_at" type="TIMESTAMP"/>
      <column name="updated_by" type="BIGINT"/>
      <column name="deleted" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="deleted_at" type="TIMESTAMP"/>
      <column name="deleted_by" type="BIGINT"/>
      <column name="order_index" type="INT"/>
    </createTable>
  </changeSet>

  <changeSet id="baseline-role" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="role"/></not>
    </preConditions>
    <createTable tableName="role">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_role" nullable="false"/>
      </column>
      <column name="tenant_code" type="VARCHAR(50)"><constraints nullable="false"/></column>
      <column name="name" type="VARCHAR(100)"><constraints nullable="false"/></column>
      <column name="label" type="VARCHAR(100)"/>
      <column name="description" type="VARCHAR(500)"/>
      <column name="is_system_role" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="public_id" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_role_public_id"/>
      </column>
      <column name="version" type="INT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
      <column name="updated_at" type="TIMESTAMP"/>
      <column name="updated_by" type="BIGINT"/>
      <column name="deleted" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="deleted_at" type="TIMESTAMP"/>
      <column name="deleted_by" type="BIGINT"/>
      <column name="order_index" type="INT"/>
    </createTable>
    <addUniqueConstraint tableName="role" columnNames="tenant_code, name"
        constraintName="uk_role_tenant_code_name"/>
  </changeSet>

  <changeSet id="baseline-user-role" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="user_role"/></not>
    </preConditions>
    <createTable tableName="user_role">
      <column name="id" type="BIGINT" autoIncrement="true">

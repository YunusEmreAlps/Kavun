      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_pages" nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(100)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_pages_code"/>

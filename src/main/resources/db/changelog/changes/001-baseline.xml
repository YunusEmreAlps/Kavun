      <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
      <column name="updated_at" type="TIMESTAMP"/>
      <column name="updated_by" type="BIGINT"/>
      <column name="deleted" type="BOOLEAN"><constraints nullable="false"/></column>
      <column name="deleted_at" type="TIMESTAMP"/>
      <column name="deleted_by" type="BIGINT"/>
      <column name="order_index" type="INT"/>
    </createTable>
  </changeSet>

  <!-- Hibernate Envers: revisions and the audit table of User (ValidityAuditStrategy). -->
  <changeSet id="baseline-revinfo" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="revinfo"/></not>
    </preConditions>
    <createSequence sequenceName="revinfo_seq" startValue="1" incrementBy="50"/>
    <createTable tableName="revinfo">
      <column name="rev" type="INT">
        <constraints primaryKey="true" primaryKeyName="pk_revinfo" nullable="false"/>
      </column>
      <column name="revtstmp" type="BIGINT"/>
    </createTable>
  </changeSet>

  <changeSet id="baseline-users-audit-log" author="kavun">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="users_audit_log"/></not>
    </preConditions>
